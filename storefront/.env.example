# Copy to .env for local dev (python-dotenv not used; export these, or let
# run_local.bat set them). On Railway, set these in the service Variables tab.

# Stripe — from dashboard.stripe.com (use test keys until launch)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — four products in Stripe (Personal/Business x Download/Cloud).
# Download prices are one-time; Cloud prices are monthly recurring.
STRIPE_PRICE_DOWNLOAD_PERSONAL=price_...
STRIPE_PRICE_DOWNLOAD_BUSINESS=price_...
STRIPE_PRICE_CLOUD_PERSONAL=price_...
STRIPE_PRICE_CLOUD_BUSINESS=price_...

# Public base URL of this storefront (no trailing slash).
# Local: http://127.0.0.1:8100   Railway: https://<service>.up.railway.app
BASE_URL=http://127.0.0.1:8100

# Database. Local default is SQLite (storefront.db next to the app).
# Railway injects DATABASE_URL automatically when you add Postgres.
# DATABASE_URL=postgresql://...

# Path to the downloadable release zip served to license holders.
# DOWNLOAD_FILE=releases/screenboard-studio.zip
