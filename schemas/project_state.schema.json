{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beltminers Project State",
  "type": "object",
  "required": [
    "project",
    "version",
    "boards",
    "assets",
    "active",
    "prohibited_inventions"
  ],
  "properties": {
    "project": {
      "const": "The Beltminers"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "boards": {
      "type": "object"
    },
    "assets": {
      "type": "object"
    },
    "active": {
      "type": "object"
    },
    "prohibited_inventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}