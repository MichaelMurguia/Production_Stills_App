{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation_spec.schema.json",
  "title": "Beltminers Production Generation Specification",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "specification_id",
    "project",
    "subject",
    "mode",
    "status",
    "canon_sources",
    "forbidden_elements",
    "canon_budget",
    "layout",
    "panels",
    "evidence_ledger"
  ],
  "properties": {
    "specification_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "const": "The Beltminers"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "CANON_EXTRACTION",
        "DESIGN_EXPLORATION"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "canon_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "APPROVED",
              "CURRENT",
              "EXCLUDED"
            ]
          }
        }
      }
    },
    "forbidden_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canon_budget": {
      "type": "object",
      "required": [
        "weak_inference_max",
        "unsupported_max"
      ],
      "properties": {
        "weak_inference_max": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_max": {
          "const": 0
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "canvas",
        "panels"
      ],
      "properties": {
        "canvas": {
          "type": "string"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "allocation_percent"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "allocation_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "required_objects",
          "forbidden_objects",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "required_objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "panel_id",
          "object",
          "evidence_class",
          "confidence",
          "status",
          "source"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "panel_id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "evidence_class": {
            "enum": [
              "SCRIPT_EXPLICIT",
              "SCRIPT_NECESSARY_INFERENCE",
              "VISUAL_CANON_LOCKED",
              "USER_DIRECTED",
              "STRONG_INFERENCE",
              "WEAK_INFERENCE",
              "PROPOSED_NOT_CANON",
              "UNSUPPORTED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "enum": [
              "PASS",
              "HOLD",
              "REMOVE"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}