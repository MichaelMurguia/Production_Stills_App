# design-drop staging (copied into storefront/app/static/…). ANCHORED:
# an unanchored `storefront_img/` matches that directory name at ANY
# depth, which silently swallowed the SERVED copy at
# storefront/app/static/storefront_img/ — google-g.svg was never
# committed and 404'd in production while working locally (2026-08-06).
/storefront_img/

# Design handoff bundles are local working files, not repo content
design_handoff/

# Replay-harness output and recorded fixture bundles: real production
# content, and large — they belong in a hand-off, not in the repo. The
# tools that make them (app/static/recorder.js, tools/build_harness.py)
# DO live in the repo.
harness/
fixtures-*.json
connectors.json

# Local polish loop (scripts/dev.py) — never the real install
.devhome/
